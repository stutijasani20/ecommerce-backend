# Project Name
PROJECT_NAME="Ecommerce Backend"
API_V1_STR="/api/v1"

# Security
# Generate a secret key: openssl rand -hex 32
SECRET_KEY="development_secret_key_change_me"
ALGORITHM="HS256"

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
# SQLALCHEMY_DATABASE_URI will be assembled by app/core/config.py from the variables above

# Stripe
# For local development: https://stripe.com/docs/keys
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend URLs
STRIPE_SUCCESS_URL="http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"

# Email
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME="Ecommerce Admin"
ADMIN_EMAIL=admin@example.com
